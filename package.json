{
  "name": "neo-commander",
  "version": "0.1.0",
  "description": "Self-hosted remote MCP: let Claude.ai operate your own computer, no paid relay",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsc && node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@wonderwhy-er/desktop-commander": "0.3.4",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "neo-commander": "dist/index.js"
  }
